# ─────────────────────────────────────────────────────────────────────────────
# FitVerse Frontend – Environment Variables Template
# Copy this file to .env and fill in your values for local development.
# In production (Vercel), set these directly in the Vercel dashboard.
# ─────────────────────────────────────────────────────────────────────────────

# Backend API base URL (no trailing slash)
# Local development:
VITE_API_BASE_URL=http://localhost:8000/api
# Production (Vercel env var):
# VITE_API_BASE_URL=https://your-fitverse-backend.onrender.com/api

# YouTube Data API v3 key – used for exercise video search
# Get your key at: https://console.cloud.google.com/apis/library/youtube.googleapis.com
VITE_YOUTUBE_API_KEY=your-youtube-api-key-here
