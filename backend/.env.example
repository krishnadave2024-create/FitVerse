# ─────────────────────────────────────────────────────────────────────────────
# FitVerse Backend – Environment Variables Template
# Copy this file to .env and fill in your values for local development.
# In production (Render), set these directly in the dashboard.
# ─────────────────────────────────────────────────────────────────────────────

# Django secret key (generate a strong random key for production)
# You can generate one at: https://djecrety.ir/
SECRET_KEY=your-strong-secret-key-here

# Set to False in production, True only for local development
DEBUG=False

# Comma-separated list of allowed hostnames (no http/https prefix)
# Example: myapp.onrender.com,localhost,127.0.0.1
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated list of allowed CORS origins (include http/https)
# Example: https://fitverse.vercel.app,http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Comma-separated list of CSRF trusted origins (include http/https)
# Should match your backend's own URL in production
CSRF_TRUSTED_ORIGINS=http://localhost:8000

# PostgreSQL connection URL (set automatically by Render Postgres)
# Format: postgresql://user:password@host:port/dbname
# Leave empty to use SQLite for local development
DATABASE_URL=
